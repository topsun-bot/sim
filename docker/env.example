# sim-replay Docker 环境配置
# 复制为 docker/.env 后修改，或由 docker/setup.sh 自动生成

# ── 通用 ──────────────────────────────────────────────
# 目标后端: mujoco | isaac | both
REPLAY_BACKEND=both

REPLAY_DATA_DIR=./data
REPLAY_OUTPUT_DIR=./output

# Docker 镜像标签
IMAGE_MUJOCO=sim-replay:mujoco
IMAGE_ISAAC=sim-replay:isaac

# 导出镜像目录（setup.sh 写入 tar）
IMAGE_EXPORT_DIR=./docker/images

# ── MuJoCo ────────────────────────────────────────────
# 无头渲染后端: egl（GPU）| osmesa（CPU）| glfw（需显示）
MUJOCO_GL=egl

# ── Isaac Sim ─────────────────────────────────────────
# 宿主机 Isaac Sim 安装路径（isaac profile 挂载用；stub 模式可留空）
ISAAC_SIM_PATH=

# NGC Isaac Sim 5.1 基础镜像
# 快速 stub 构建可改为: python:3.11-slim
ISAAC_SIM_IMAGE=nvcr.io/nvidia/isaac-sim:5.1.0

# Isaac Sim 容器必需（NGC 许可协议）
ACCEPT_EULA=Y
PRIVACY_CONSENT=Y

# NGC API Key（拉取 isaac-sim 镜像时需要，可选）
NGC_API_KEY=

# GPU 运行时
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
