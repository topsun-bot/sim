ARG ISAAC_BASE_IMAGE=python:3.11-slim
FROM ${ISAAC_BASE_IMAGE}

LABEL description="D1 MCAP replay — Isaac Sim profile (NGC 5.1 / slim)"

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV REPLAY_BACKEND=isaac
ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility,graphics
ENV ISAAC_SIM_PATH=/isaac-sim
ENV ACCEPT_EULA=Y
ENV PRIVACY_CONSENT=Y

# 仅 slim 基础镜像安装系统 Python
RUN if [ ! -d /isaac-sim ]; then \
      apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip libgl1 libglib2.0-0 \
      && rm -rf /var/lib/apt/lists/*; \
    fi

COPY pyproject.toml README.md /app/
COPY replay /app/replay
COPY assets /app/assets

# NGC Isaac Sim 5.1 使用 python.sh 加载 Omniverse 环境后安装
RUN set -eux; \
    if [ -x /isaac-sim/python.sh ]; then \
      /isaac-sim/python.sh -m pip install --no-cache-dir .; \
    else \
      PY="$(command -v python3)"; \
      "$PY" -m pip install --upgrade pip setuptools wheel; \
      "$PY" -m pip install --no-cache-dir .; \
    fi

RUN set -eux; \
    if [ -x /isaac-sim/python.sh ]; then \
      /isaac-sim/python.sh -c "\
import omni; \
import replay; \
from replay.backends.isaac_backend import IsaacSimBackend; \
b = IsaacSimBackend(); \
assert b._available, 'omni not available'; \
print('replay isaac 5.1 OK')"; \
    else \
      python3 -c "import replay; print('replay isaac stub OK')"; \
    fi

COPY --chmod=755 docker/entrypoint.sh /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["run", "--backend", "isaac", "--mcap", "/data/eda9cc2192f7.mcap", "--meta", "/data/eda9cc2192f7.meta.json", "--output", "/output/eda9cc2192f7"]
